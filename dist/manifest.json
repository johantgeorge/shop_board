{
  "manifest_version": 3,
  "name": "ShopBoard",
  "version": "0.1.0",
  "description": "Barebones local product board dashboard for saved shopping items.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open ShopBoard",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scraper.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scraper.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
